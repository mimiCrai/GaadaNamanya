# Application
PORT=3000
SERVICE_NAME=field-report-processor
NODE_ENV=local

# Kafka
KAFKA_BROKERS=kafka:29092
KAFKA_CLIENT_ID=field-report-processor
KAFKA_GROUP_ID=field-report-processor-group
KAFKA_TOPIC=field-reports
LAG_POLL_INTERVAL_MS=5000

# Aggregator (Canonical Store owner, rule 5); fake example key
BNPB_GATEWAY_BASE_URL=http://bnpb-aggregator-entry:3000
BNPB_GATEWAY_TIMEOUT_MS=2000
BNPB_INTERNAL_API_KEY=0123456789abcdef0123456789abcdef

# Processing policy (D-39)
FIELD_REPORT_MAX_MESSAGE_BYTES=65536
FIELD_REPORT_MAX_PERMANENT_ATTEMPTS=3
FIELD_REPORT_BACKOFF_BASE_MS=500
FIELD_REPORT_BACKOFF_CAP_MS=30000
