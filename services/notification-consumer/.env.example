# Application
PORT=3000
SERVICE_NAME=repo-template
NODE_ENV=local

# Notification Consumer database
DATABASE_URL=postgresql://postgres:password@localhost:5435/notifications

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=notification-consumer
KAFKA_GROUP_ID=notification-consumer-group
KAFKA_TOPIC=hazard-events

# Optional distributed tracing (disabled without a collector).
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
