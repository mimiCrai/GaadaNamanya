PORT=3000
SERVICE_NAME=fire-processor
NODE_ENV=local

# satellite.raw (1 partition, read_committed)
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=fire-processor
KAFKA_GROUP_ID=fire-processor-group
SATELLITE_RAW_TOPIC=satellite.raw

# Aggregator owns the Canonical Store (rule 5); fake example key
BNPB_GATEWAY_BASE_URL=http://localhost:3003
BNPB_GATEWAY_TIMEOUT_MS=15000
BNPB_INTERNAL_API_KEY=replace-with-internal-api-key-at-least-32-chars

# D-25: read at start only; a stored snapshot keeps its own value
FIRE_ALLOWED_LATENESS_MINUTES=120
FIRE_FLUSH_MAX_RECORDS=1000
FIRE_SNAPSHOT_EVERY_RECORDS=5000
FIRE_SNAPSHOT_INTERVAL_MS=30000
FIRE_BATCH_MAX_OPS=500
FIRE_BATCH_MAX_BYTES=3145728
FIRE_BACKOFF_BASE_MS=500
FIRE_BACKOFF_CAP_MS=30000

# Optional distributed tracing (disabled without a collector).
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
