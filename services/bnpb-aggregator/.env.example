# Application
PORT=3000
SERVICE_NAME=repo-template
NODE_ENV=local

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/app

# Kafka
# Comma-separate brokers when running a cluster.
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=bnpb-aggregator
KAFKA_TOPIC=hazard-events

# Source REST clients. These credentials must match the source services' own configuration.
BMKG_BASE_URL=http://localhost:8081
BMKG_API_KEY=local-bmkg-api-key
BMKG_REQUEST_TIMEOUT_MS=5000
PVMBG_BASE_URL=http://localhost:8082
PVMBG_TOKEN=local-pvmbg-token
PVMBG_REQUEST_TIMEOUT_MS=10000

# Background polling and durable Kafka outbox relay
POLL_INTERVAL_MS=3000
POLL_OVERLAP_MS=1000
OUTBOX_RELAY_INTERVAL_MS=250
OUTBOX_BATCH_SIZE=100
