# Application
PORT=3000
SERVICE_NAME=repo-template
NODE_ENV=local

# MongoDB (run locally inside Compose; no database host ports are exposed)
DATABASE_URL=mongodb://bnpb:local-mongo-app-password@canonical-store:27017/canonical_store?authSource=canonical_store
DATABASE_NAME=canonical_store
BNPB_AUDIT_TOKEN=local-demo-audit-token-0123456789abcdef
STORAGE_READ_TIMEOUT_MS=2000
MONGO_NODE_MAP={}
BACKGROUND_LEASE_MS=15000
BACKGROUND_LEASE_RENEW_MS=2000
LEASE_OPERATION_TIMEOUT_MS=3000
KAFKA_TRANSACTIONAL_ID=bnpb-aggregator-outbox

# Kafka
# Comma-separate brokers when running a cluster.
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=bnpb-aggregator
KAFKA_TOPIC=hazard-events

# Shared with the BNPB Client API only. Generate a distinct value per environment.
BNPB_INTERNAL_API_KEY=0123456789abcdef0123456789abcdef

# Source REST clients. These credentials must match the source services' own configuration.
BMKG_BASE_URL=http://localhost:8081
BMKG_API_KEY=local-bmkg-api-key
BMKG_REQUEST_TIMEOUT_MS=5000
PVMBG_BASE_URL=http://localhost:8082
PVMBG_TOKEN=local-pvmbg-token
PVMBG_REQUEST_TIMEOUT_MS=10000

# Background polling and durable Kafka outbox relay
POLL_INTERVAL_MS=3000
POLL_OVERLAP_MS=1000
OUTBOX_RELAY_INTERVAL_MS=250
OUTBOX_BATCH_SIZE=100
