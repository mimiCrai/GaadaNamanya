# Application
PORT=3000
SERVICE_NAME=repo-template
NODE_ENV=local

# TODO: Replace these development URLs with the deployed internal URLs.
BNPB_AUTH_PUBLIC_KEY_URL=http://localhost:3001/public-key
BNPB_GATEWAY_BASE_URL=http://localhost:3003
# Must match BNPB_AGGREGATOR_INTERNAL_API_KEY.
BNPB_INTERNAL_API_KEY=0123456789abcdef0123456789abcdef
# POST /internal-ops/dlq/replay (batch requeue, D-37)
DLQ_REPLAY_TIMEOUT_MS=30000
JWT_PUBLIC_KEY_CACHE_MS=60000
JWT_PUBLIC_KEY_MIN_REFRESH_MS=5000

# Per-instance starting limits; tune with load tests.
ADMISSION_MAX_CONCURRENT_REQUESTS=100
ADMISSION_RESERVED_LAPANGAN_REQUESTS=20
ADMISSION_RETRY_AFTER_SECONDS=1

# Field reports (P3 #6, D-38): empty KAFKA_BROKERS disables the receiver (503)
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=bnpb-client-api
FIELD_REPORT_TOPIC=field-reports
FIELD_REPORT_PUBLISH_TIMEOUT_MS=2000
FIELD_REPORT_MAX_BODY_BYTES=16384
FIELD_REPORT_RETRY_AFTER_SECONDS=2

# Optional distributed tracing (disabled without a collector).
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
