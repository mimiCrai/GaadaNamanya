# Application
PORT=3000
SERVICE_NAME=repo-template
NODE_ENV=local

# Authentication (RS256)
# Generate with: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
# Store the PEM on one line with literal \n separators, e.g. -----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
JWT_PRIVATE_KEY=
JWT_ACCESS_TTL_SECONDS=60
JWT_REFRESH_TTL_SECONDS=604800

# Initial administrator provisioning (used only by `npm run db:seed-admin`)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/app
