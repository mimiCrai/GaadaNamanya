# Application
PORT=3000
SERVICE_NAME=repo-template
NODE_ENV=local

# Dashboard Consumer database
DATABASE_URL=postgresql://postgres:password@localhost:5434/dashboard

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=dashboard-consumer
KAFKA_GROUP_ID=dashboard-consumer-group
KAFKA_TOPIC=hazard-events

# Canonical analytics is served by the owning Aggregator service.
CANONICAL_ANALYTICS_URL=http://bnpb-aggregator-entry:3000/internal/analytics
BNPB_INTERNAL_API_KEY=replace-with-aggregator-internal-key
