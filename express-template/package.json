{
    "name": "repo-template",
    "version": "1.0.0",
    "description": "Node.js API template with Express, Inversify, Drizzle ORM",
    "main": "dist/src/server.js",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "start": "node ./dist/src/server.js",
        "dev": "tsx watch --env-file=.env src/server.ts",
        "build": "tsc",
        "lint": "eslint .",
        "lint:fix": "eslint --fix .",
        "test": "jest --runInBand",
        "test:watch": "npm run test -- --watch",
        "format": "prettier --config .prettierrc.json --write '**/*.{js,jsx,ts,tsx,css,json,yml,yaml}'",
        "format:check": "prettier --config .prettierrc.json --check '**/*.{js,jsx,ts,tsx,css,json,yml,yaml}'",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:push": "drizzle-kit push",
        "db:studio": "drizzle-kit studio"
    },
    "dependencies": {
        "amqplib": "^0.10.4",
        "body-parser": "^1.20.2",
        "compression": "^1.7.4",
        "drizzle-orm": "^0.45.2",
        "express": "^4.21.0",
        "express-openapi-validator": "^5.3.2",
        "inversify": "^6.0.2",
        "inversify-express-utils": "^6.4.6",
        "pg": "^8.12.0",
        "pino": "^9.3.2",
        "pino-http": "^10.2.0",
        "pino-pretty": "^11.2.2",
        "redis": "^4.7.0",
        "reflect-metadata": "^0.2.2",
        "uuid": "^11.0.0",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/amqplib": "^0.10.5",
        "@types/compression": "^1.7.5",
        "@types/express": "^4.17.21",
        "@types/jest": "^29.5.12",
        "@types/node": "^22.3.0",
        "@types/pg": "^8.11.6",
        "@types/supertest": "^6.0.2",
        "@types/uuid": "^10.0.0",
        "@typescript-eslint/eslint-plugin": "^8.1.0",
        "@typescript-eslint/parser": "^8.1.0",
        "drizzle-kit": "^0.31.10",
        "eslint": "^9.9.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-prettier": "^5.2.1",
        "jest": "^29.7.0",
        "prettier": "^3.3.3",
        "supertest": "^7.0.0",
        "ts-jest": "^29.2.4",
        "tsx": "^4.19.0",
        "typescript": "^5.5.4"
    },
    "author": "",
    "license": "UNLICENSED",
    "private": true
}
