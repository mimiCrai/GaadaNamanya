# Canonical Store (PostgreSQL)
CANONICAL_STORE_DB_USER=postgres
CANONICAL_STORE_DB_PASSWORD=password
CANONICAL_STORE_DB_NAME=canonical_store
CANONICAL_STORE_HOST_PORT=5433

# Kafka broker
KAFKA_NODE_ID=1
KAFKA_PROCESS_ROLES=broker,controller
KAFKA_CONTROLLER_QUORUM_VOTERS=1@kafka:29093
KAFKA_LISTENERS=PLAINTEXT://kafka:29092,CONTROLLER://kafka:29093,PLAINTEXT_HOST://0.0.0.0:9092
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:29092,PLAINTEXT_HOST://localhost:9092
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT,PLAINTEXT_HOST:PLAINTEXT
KAFKA_INTER_BROKER_LISTENER_NAME=PLAINTEXT
KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS=0
KAFKA_AUTO_CREATE_TOPICS_ENABLE=true
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_HOST_PORT=9092
KAFKA_INTERNAL_BOOTSTRAP_SERVER=kafka:29092

# BNPB Aggregator
BNPB_AGGREGATOR_HOST_PORT=3003
BNPB_AGGREGATOR_CONTAINER_PORT=3000
BNPB_AGGREGATOR_SERVICE_NAME=bnpb-aggregator
BNPB_AGGREGATOR_NODE_ENV=local
BNPB_AGGREGATOR_DATABASE_URL=postgresql://postgres:password@canonical-store:5432/canonical_store
BNPB_AGGREGATOR_KAFKA_BROKERS=kafka:29092
BNPB_AGGREGATOR_KAFKA_CLIENT_ID=bnpb-aggregator
BNPB_AGGREGATOR_KAFKA_TOPIC=hazard-events
BNPB_AGGREGATOR_BMKG_BASE_URL=http://bmkg:8081
BNPB_AGGREGATOR_BMKG_API_KEY=local-bmkg-api-key
BNPB_AGGREGATOR_BMKG_REQUEST_TIMEOUT_MS=5000
BNPB_AGGREGATOR_PVMBG_BASE_URL=http://pvmbg:8082
BNPB_AGGREGATOR_PVMBG_TOKEN=local-pvmbg-token
BNPB_AGGREGATOR_PVMBG_REQUEST_TIMEOUT_MS=10000
BNPB_AGGREGATOR_POLL_INTERVAL_MS=3000
BNPB_AGGREGATOR_POLL_OVERLAP_MS=1000
BNPB_AGGREGATOR_OUTBOX_RELAY_INTERVAL_MS=250
BNPB_AGGREGATOR_OUTBOX_BATCH_SIZE=100

# Dashboard Consumer
DASHBOARD_CONSUMER_HOST_PORT=3004
DASHBOARD_CONSUMER_CONTAINER_PORT=3000
DASHBOARD_CONSUMER_SERVICE_NAME=dashboard-consumer
DASHBOARD_CONSUMER_NODE_ENV=local
DASHBOARD_CONSUMER_KAFKA_BROKERS=kafka:29092
DASHBOARD_CONSUMER_KAFKA_CLIENT_ID=dashboard-consumer
DASHBOARD_CONSUMER_KAFKA_GROUP_ID=dashboard-consumer-group
DASHBOARD_CONSUMER_KAFKA_TOPIC=hazard-events

# Notification Consumer
NOTIFICATION_CONSUMER_HOST_PORT=3005
NOTIFICATION_CONSUMER_CONTAINER_PORT=3000
NOTIFICATION_CONSUMER_SERVICE_NAME=notification-consumer
NOTIFICATION_CONSUMER_NODE_ENV=local
NOTIFICATION_CONSUMER_KAFKA_BROKERS=kafka:29092
NOTIFICATION_CONSUMER_KAFKA_CLIENT_ID=notification-consumer
NOTIFICATION_CONSUMER_KAFKA_GROUP_ID=notification-consumer-group
NOTIFICATION_CONSUMER_KAFKA_TOPIC=hazard-events
