BNPB_AGGREGATOR_BMKG_API_KEY=bmkg_demo_51bf06e97d2938502cbf16be2597b5c8
BNPB_AGGREGATOR_BMKG_REQUEST_TIMEOUT_MS=5000
BNPB_AGGREGATOR_PVMBG_BASE_URL=http://pvmbg:8082
BNPB_AGGREGATOR_PVMBG_TOKEN=pvmbg.bnpb.6d2c7d0fe8f70106d73fc97e57153275
BNPB_AGGREGATOR_PVMBG_REQUEST_TIMEOUT_MS=10000
BNPB_AGGREGATOR_POLL_INTERVAL_MS=3000
BNPB_AGGREGATOR_POLL_OVERLAP_MS=1000
BNPB_AGGREGATOR_OUTBOX_RELAY_INTERVAL_MS=250
BNPB_AGGREGATOR_OUTBOX_BATCH_SIZE=100
# Safe decoding + unprocessed-message store
BNPB_AGGREGATOR_PVMBG_MAX_BODY_BYTES=5242880
BNPB_AGGREGATOR_DECODE_MAX_DEPTH=64
BNPB_AGGREGATOR_DLQ_INLINE_MAX_BYTES=1048576
BNPB_AGGREGATOR_DLQ_INSPECT_MAX_BYTES=8388608
BNPB_AGGREGATOR_DLQ_MAX_ATTEMPTS=5
BNPB_AGGREGATOR_DLQ_RETRY_BASE_MS=2000
BNPB_AGGREGATOR_DLQ_RETRY_CAP_MS=300000
BNPB_AGGREGATOR_DLQ_RETRY_INTERVAL_MS=2000
BNPB_AGGREGATOR_DLQ_RETRY_BATCH_SIZE=20
BNPB_AGGREGATOR_DLQ_CLAIM_MS=30000
# MAPPING_DIR is bind-mounted as a DIRECTORY onto /app/config/pvmbg-mapping (read-only); demos point it at a copy.
BNPB_AGGREGATOR_DLQ_REPLAY_MAX=5000
BNPB_AGGREGATOR_PVMBG_BODY_FAILURE_HOLD_POLLS=5
BNPB_AGGREGATOR_PVMBG_MAPPING_DIR=./services/bnpb-aggregator/config/pvmbg-mapping
BNPB_AGGREGATOR_PVMBG_MAPPING_PATH=config/pvmbg-mapping/mapping.json
BNPB_AGGREGATOR_PVMBG_MAPPING_POLL_MS=2000
# Satellite feed ingest. Leader-only SSE reader -> Kafka topic satellite.raw.
# Keep ENABLED=false unless you mean to open THE ONE allowed stream connection (CONTEXT.md rule 2).
# The token is a Secret: put the real group token only in .env (k8s: Secret), never commit it.
BNPB_AGGREGATOR_SATELLITE_INGEST_ENABLED=false
BNPB_AGGREGATOR_SATELLITE_BASE_URL=https://satellite.naufarrel.dev
BNPB_AGGREGATOR_SATELLITE_TOKEN=replace-with-group-token
BNPB_AGGREGATOR_SATELLITE_RAW_TOPIC=satellite.raw
BNPB_AGGREGATOR_KAFKA_SATELLITE_TRANSACTIONAL_ID=bnpb-aggregator-satellite
BNPB_AGGREGATOR_SATELLITE_CHECKPOINT_GROUP=bnpb-satellite-checkpoint
BNPB_AGGREGATOR_SATELLITE_BATCH_MAX=200
# Byte budget per record batch in satellite.raw (capped by the topic max.message.bytes at start)
BNPB_AGGREGATOR_SATELLITE_BATCH_MAX_BYTES=921600
BNPB_AGGREGATOR_SATELLITE_BATCH_LINGER_MS=100
BNPB_AGGREGATOR_SATELLITE_MAX_EVENT_BYTES=1048576
BNPB_AGGREGATOR_SATELLITE_CONNECT_TIMEOUT_MS=10000
BNPB_AGGREGATOR_SATELLITE_IDLE_TIMEOUT_MS=60000
BNPB_AGGREGATOR_SATELLITE_SESSION_POLL_MS=10000
BNPB_AGGREGATOR_SATELLITE_BACKOFF_BASE_MS=1000
BNPB_AGGREGATOR_SATELLITE_BACKOFF_CAP_MS=60000
BNPB_AGGREGATOR_SATELLITE_429_BACKOFF_BASE_MS=2000
BNPB_AGGREGATOR_SATELLITE_429_BACKOFF_CAP_MS=30000
BNPB_AGGREGATOR_SATELLITE_AUTH_BACKOFF_MS=300000

