# Canonical Store (MongoDB sharded cluster; demo credentials)
CANONICAL_STORE_ROOT_USER=admin
CANONICAL_STORE_ROOT_PASSWORD=local-mongo-admin-password
CANONICAL_STORE_CLUSTER_KEY=bW9uZ28tY2Fub25pY2FsLXN0b3JlLWxvY2FsLWRlbW8ta2V5LWNoYW5nZS1mb3ItZGVwbG95bWVudA==
CANONICAL_STORE_DB_USER=bnpb
CANONICAL_STORE_DB_PASSWORD=local-mongo-app-password
CANONICAL_STORE_DB_NAME=canonical_store
CANONICAL_STORE_TRANSACTION_LIFETIME_SECONDS=10

# Auth Store (PostgreSQL; used by bnpb-auth in the E2E stack)
AUTH_STORE_DB_USER=postgres
AUTH_STORE_DB_PASSWORD=password
AUTH_STORE_DB_NAME=auth
BNPB_AUTH_HOST_PORT=3001
BNPB_CLIENT_API_HOST_PORT=3000

# Per-instance starting limits; tune with load tests.
BNPB_CLIENT_API_ADMISSION_MAX_CONCURRENT_REQUESTS=100
BNPB_CLIENT_API_ADMISSION_RESERVED_LAPANGAN_REQUESTS=20
BNPB_CLIENT_API_ADMISSION_RETRY_AFTER_SECONDS=1

# Field reports: POST /field-reports answers 202 only after the Kafka ack (D-38)
FIELD_REPORT_TOPIC=field-reports
BNPB_CLIENT_API_KAFKA_BROKERS=kafka:29092
BNPB_CLIENT_API_KAFKA_CLIENT_ID=bnpb-client-api
BNPB_CLIENT_API_FIELD_REPORT_PUBLISH_TIMEOUT_MS=2000
BNPB_CLIENT_API_FIELD_REPORT_MAX_BODY_BYTES=16384
BNPB_CLIENT_API_FIELD_REPORT_RETRY_AFTER_SECONDS=2
# DLQ replay requeues a batch; longer budget than single reads (D-37)
BNPB_CLIENT_API_DLQ_REPLAY_TIMEOUT_MS=30000

